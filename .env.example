# Copy to .env.local and adjust. Nothing here is secret.

# Where the app sends API requests. "/api" is this app's own mock backend
# (app/api/[...path]/route.ts); later it proxies to the Express server.
NEXT_PUBLIC_API_BASE=/api

# The mock backend's realism (mocks/router.ts):
# average delay per request in milliseconds (±50%),
MOCK_LATENCY_MS=400
# and the share of requests that fail with a 503, 0 to 1. Try 0.3 to see
# every loading and error state.
MOCK_FAILURE_RATE=0
